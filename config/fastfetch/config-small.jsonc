{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
  "type": "file",
  "source": "~/.config/fastfetch/logo/daedalus-small.txt",
  "color": { "1": "yellow" },
  "padding": {
  "top": 1,
  "right": 4,
  "left": 1
}
},
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────SYSTEMS──────────────────────┐"
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "yellow"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "showPeCoreCount": true,
      "keyColor": "yellow"
    },
    {
      "type": "gpu",
      "key": "│ ├",
      "detectionMethod": "pci",
      "keyColor": "yellow"
    },
    {
      "type": "display",
      "key": "│ ├󱄄",
      "keyColor": "yellow"
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "keyColor": "yellow"
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐"
    },
    {
      "type": "command",
      "key": "\ue900 OS",
      "keyColor": "cyan",
      "text": "version=$(omarchy-version); echo \"Omarchy $version\""
    },
    {
      "type": "command",
      "key": "│ ├󰘬",
      "keyColor": "cyan",
      "text": "branch=$(omarchy-version-branch); echo \"$branch\""
    },
    {
      "type": "command",
      "key": "│ ├󰔫",
      "keyColor": "cyan",
      "text": "channel=$(omarchy-version-channel); echo \"$channel\""
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "cyan"
    },
    {
      "type": "de",
      "key": " DE",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "cyan"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "cyan"
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "cyan"
    },
    {
      "type": "command",
      "key": "│ ├󰸌",
      "keyColor": "cyan",
      "text": "theme=$(omarchy-theme-current); echo -e \"$theme \\e[38m●\\e[37m●\\e[36m●\\e[35m●\\e[34m●\\e[33m●\\e[32m●\\e[31m●\""
    },
    {
      "type": "terminalfont",
      "key": "└ └",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────STATUS───────────────┐"
    },
    {
      "type": "command",
      "key": "󱦟 OS Age",
      "keyColor": "yellow",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    {
      "type": "uptime",
      "key": "󱫐 Uptime",
      "keyColor": "yellow"
    },
    {
      "type": "command",
      "key": " Update",
      "keyColor": "yellow",
      "text": "updated=$(omarchy-version-pkgs); echo \"$updated\""
    },
    {
  "type": "custom",
  "format": "◇ Craft: Daedalus\n◇ Mission: Exploration\n◇ Status: Operational"
},
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘"
    },
    "break"
  ]
}
